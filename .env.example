# URL pública do site, sem barra no final. Só "https://assessorialpha.com" é
# indexada; qualquer outra (ex.: deploy temporário *.vercel.app) sai com noindex.
NEXT_PUBLIC_SITE_URL=https://assessorialpha.com

# Base das páginas que continuam no WordPress (Blog, Cursos, Cases, Alpha's
# Pizzaria, matérias). Trocar quando o WP mudar de endereço.
NEXT_PUBLIC_WP_URL=https://assessorialpha.com

# CRM comercial (Dashboard-Comercial-Back-V2): o lead do form vai para
# POST {CRM_API_URL}/external/leads com destination "hq" (lib/crm.ts).
# A chave é a EXTERNAL_LEADS_API_KEY do CRM.
CRM_API_URL=
CRM_EXTERNAL_LEADS_API_KEY=

# Opcional: e-mail do SDR da Matriz que vira dono do lead (campo sdr_email).
# Precisa ser de um usuário ativo do CRM; senão o lead entra sem responsável.
# Vazio = o campo não é enviado.
CRM_SDR_EMAIL=

# Opcional: rate limit do form (lib/rate-limit.ts). Upstash Console > Redis > REST API.
# Vazio = sem rate limit (deixa passar e loga).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
